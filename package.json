{
  "name": "koufengqin-simulator",
  "productName": "口琴模拟器",
  "version": "1.0.0",
  "description": "口琴模拟、透明跟谱与自动模拟键鼠弹奏",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir",
    "pack:win": "electron-builder --win portable --x64",
    "pack:win:dir": "electron-builder --win dir --x64"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.koufengqin.simulator",
    "productName": "口琴模拟器",
    "forceCodeSigning": false,
    "files": [
      "index.html",
      "electron/**",
      "library/**",
      "package.json",
      "node_modules/koffi/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "口琴模拟器.exe"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "koffi@3.2.1": true
  },
  "dependencies": {
    "koffi": "^3.2.1"
  }
}
